# Nexgile WealthAgent environment template
# Copy to `.env` and replace CHANGE_ME values. Never commit `.env`.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required. Use a 32+ character random string.
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Compose local demo uses PostgreSQL. Do not point this at SQLite for the demo.
POSTGRES_USER=wealthagent
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wealthagent
DATABASE_URL=postgresql://wealthagent:CHANGE_ME@localhost:5432/wealthagent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6379/0

# Local Docker demo: keep SQLite and memory cache OFF.
# Tests set these true themselves. Production must keep them false.
ALLOW_SQLITE=false
ALLOW_MEMORY_CACHE=false
ALLOW_DEMO_SEED=true
ALLOW_CREATE_ALL=false
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI: Groq is optional and used only by the FastAPI backend. Leave empty for deterministic answers.
AI_PROVIDER=deterministic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE=https://api.groq.com/openai/v1

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
OBJECT_STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1

# Book of record currency. Presentation uses ₹ and Indian grouping (en-IN).
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_LOCALE=en-IN

# Frontend: leave empty so the Vite proxy is used.
VITE_API_URL=
VITE_PROXY_TARGET=http://backend:8000
